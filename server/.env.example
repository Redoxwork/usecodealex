# Copy this file to .env (same folder) and fill it in. Never share .env or put it on GitHub.

# The public address of the site, no slash at the end.
SITE_URL=https://usecodealex.com

# Where the server listens. Caddy (see LAUNCH.md) sits in front on ports 80/443.
PORT=8080
HOST=127.0.0.1

# Long random secret for sign-in cookies. Make one with:  openssl rand -hex 32
SESSION_SECRET=

# Alex's Kick username. This account is always the owner of the admin.
OWNER_KICK=alexx

# Kick developer app (kick.com/settings/developer). Redirect URL must be:
#   https://usecodealex.com/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Kick webhooks (chat check-ins + instant live status). Set to off to disable.
# KICK_WEBHOOKS=on

# Vega affiliate API. Leave VEGA_API_URL empty until Vega sends the details.
# {start} and {end} become the race start/end dates (ISO), {start_ms}/{end_ms} unix ms.
VEGA_API_URL=
VEGA_API_KEY=
VEGA_API_HEADER=Authorization
VEGA_LIST_PATH=data
VEGA_NAME_FIELD=username
VEGA_WAGER_FIELD=wagered
VEGA_DIVIDE=1

# Rugs.fun referral data. Same idea; DIVIDE=1000000000 if they send lamports.
RUGS_API_URL=
RUGS_API_KEY=
RUGS_API_HEADER=Authorization
RUGS_LIST_PATH=data
RUGS_NAME_FIELD=username
RUGS_WAGER_FIELD=wagered
RUGS_DIVIDE=1

# How often to pull wagers, in seconds (minimum 30).
POLL_SECONDS=120

# Testing on your own computer only: lets you sign in without Kick via /auth/dev?u=alexx
# The server refuses to start with this on when SITE_URL is https.
# DEV_LOGIN=1
